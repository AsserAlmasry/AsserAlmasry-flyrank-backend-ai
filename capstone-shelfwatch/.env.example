# --- security: CHANGE THIS. Any long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=60

# --- scanning
TARGET_START_URL=https://books.toscrape.com/catalogue/page-1.html
SCAN_PAGES=3                 # catalogue pages per scan (20 books each)
PAGE_CACHE_HOURS=6           # politeness cache: pages younger than this are not fetched again
DEMO_DRIFT=0                 # 1 = simulate small price/stock moves (the sandbox site never changes) - demo only

# --- scheduler (cron)
SCHEDULER_ENABLED=true
SCAN_CRON=0 6 * * *          # every day at 06:00
REPORT_CRON=0 7 * * 1        # every Monday at 07:00
SCHEDULER_TZ=Africa/Cairo

# --- LLM (any OpenAI-compatible provider). LLM_STUB=1 = no model call, keyword rules instead (offline demo).
LLM_STUB=1
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b
LLM_TIMEOUT_S=30
