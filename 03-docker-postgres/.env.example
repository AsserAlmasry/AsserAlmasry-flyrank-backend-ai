# Copy to .env and change the password. .env is gitignored, this file is committed.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks
# Used by the app. Inside docker compose the host is "db"; from your laptop it is "localhost".
DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks
# memory | postgres
STORAGE=postgres
