# Any OpenAI-compatible provider works through the OpenAI SDK: OpenAI, Groq, OpenRouter, Ollama...
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.1-8b-instant
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=gemma3:1b   LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=gpt-4o-mini

# 1 = offline demo mode: no LLM call, a tiny keyword rule answers YES/NO (for trying the UI without a key)
LLM_STUB=0
