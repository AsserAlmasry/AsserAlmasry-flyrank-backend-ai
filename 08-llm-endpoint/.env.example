# The only three values that decide WHICH model runs. Swap them to change provider; change no code.
# Ollama (local, free, no key):   LLM_BASE_URL=http://localhost:11434/v1/   LLM_API_KEY=ollama   LLM_MODEL=gemma3:1b
# OpenRouter (hosted, free tier): LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...  LLM_MODEL=openrouter/free
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=gemma3:1b

# Behaviour switches
LLM_STUB=0          # 1 = never call the model, return a fixed schema-valid answer (free development)
LLM_ENABLED=true    # false = kill switch: skip the model, return the deterministic fallback
LLM_TIMEOUT_S=30    # hard timeout per model call
